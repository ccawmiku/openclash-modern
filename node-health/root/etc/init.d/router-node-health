#!/bin/sh /etc/rc.common
START=96
USE_PROCD=1
start_service() {
 . /lib/functions.sh
 config_load router_node_health
 config_get_bool enabled main enabled 0
 [ "$enabled" = 1 ] || return 0
 mkdir -p /var/run/router-node-health /etc/router-node-health
 chmod 700 /var/run/router-node-health /etc/router-node-health
 procd_open_instance
 procd_set_param command /usr/bin/lua /usr/share/router-node-health/daemon.lua
 procd_set_param nice 15
 procd_set_param limits as="67108864" core="0" nofile="64"
 procd_set_param respawn 3600 5 5
 procd_close_instance
}
service_triggers() { procd_add_reload_trigger router_node_health; }
