#!/bin/sh /etc/rc.common
START=19
STOP=89
USE_PROCD=1

start_service() {
 . /lib/functions.sh
 config_load router_privacy
 config_get_bool monitor main monitor_enabled 0
 config_get_bool dns main dns_enabled 0
 mkdir -p /var/run/router-privacy
 chmod 700 /var/run/router-privacy
 if [ "$dns" = 1 ]; then
  /usr/share/router-privacy/guard.lua apply || return 1
  config_get resolver main resolver_url
  config_get fallback main fallback_url
  procd_open_instance bootstrap
  procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/var/run/router-privacy/bootstrap.conf --pid-file=/var/run/router-privacy/bootstrap.pid
  procd_set_param respawn 3600 5 5
  procd_set_param limits core="0" as="33554432"
  procd_close_instance
  for item in "$resolver:53531" "$fallback:53532"; do
   [ -n "$item" ] || continue
   port="${item##*:}"
   url="${item%:*}"
   [ -n "$url" ] || continue
   procd_open_instance "resolver-$port"
   procd_set_param command /usr/sbin/https-dns-proxy -r "$url" -a 127.0.0.1 -p "$port" -b 127.0.0.1:53533 -i 60 -u nobody -g nogroup
   procd_set_param respawn 3600 5 5
   procd_set_param limits core="0" as="67108864" nofile="128"
   procd_set_param stdout 0
   procd_set_param stderr 1
   procd_close_instance
  done
  procd_open_instance dns
  procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/var/run/router-privacy/dnsmasq.conf --pid-file=/var/run/router-privacy/dnsmasq.pid
  procd_set_param respawn 3600 5 5
  procd_set_param limits core="0" as="33554432"
  procd_set_param stdout 0
  procd_set_param stderr 1
  procd_close_instance
  procd_open_instance dns-route
  procd_set_param command /usr/bin/lua /usr/share/router-privacy/dns_watch.lua
  procd_set_param nice 15
  procd_set_param respawn 3600 5 5
  procd_set_param limits core="0" as="33554432" nofile="64"
  procd_close_instance
 else
  /usr/share/router-privacy/guard.lua disable
 fi
 if [ "$monitor" = 1 ]; then
  config_get lans main lan_interface br-lan
  lans="$(printf '%s' "$lans" | tr ' ' ',')"
  procd_open_instance capture
  procd_set_param command /bin/sh /usr/share/router-privacy/capture.sh "$lans" /var/run/router-privacy/capture.json
  procd_set_param nice 15
  procd_set_param respawn 3600 5 5
  procd_set_param limits core="0" as="67108864" nofile="64"
  procd_set_param stdout 0
  procd_set_param stderr 1
  procd_close_instance
 fi
 if [ "$monitor" = 1 ] || [ "$dns" = 1 ]; then
  procd_open_instance summary
  procd_set_param command /usr/bin/lua /usr/share/router-privacy/monitor.lua
  procd_set_param nice 15
  procd_set_param respawn 3600 5 5
  procd_set_param limits core="0" as="67108864" nofile="64"
  procd_set_param stdout 0
  procd_set_param stderr 1
  procd_close_instance
 fi
}

service_triggers() {
 procd_add_reload_trigger router_privacy
 procd_add_interface_trigger "interface.*" "wan" /etc/init.d/router-privacy reload
 procd_add_interface_trigger "interface.*" "lan" /etc/init.d/router-privacy reload
}

# A process crash/stop never removes active protection. Only explicit dns_enabled=0
# and a reload removes the guard. OpenClash stop never calls this service.
stop_service() { :; }
